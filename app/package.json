{
  "name": "aqui-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "fixtures": "node scripts/build-fixtures.mjs",
    "predev": "npm run tokens && npm run fixtures",
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "prebuild": "npm run tokens && npm run fixtures",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "pretest": "npm run tokens && npm run fixtures",
    "test": "vitest run",
    "mock": "python3 dev/server.py"
  },
  "dependencies": {
    "maplibre-gl": "4.7.1",
    "pannellum": "2.5.6",
    "pmtiles": "3.2.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "esbuild": "0.25.12",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
